# All optional — the app runs in local demo mode with none of these set.

# Signs the demo persona cookie. Change for any shared deployment.
DEMO_SESSION_SECRET=change-me-for-any-shared-deployment

# Optional persistence: PostgreSQL + PostGIS (docker compose up -d, or Supabase).
# When set, server code uses PrismaRepository; the browser demo state is unaffected.
# DATABASE_URL=postgresql://meithera:meithera@localhost:5432/meithera
